# Defined by the Rust extension under ext/ciborium, which rbs-inline cannot read.
module Ciborium
  module Native
    FLAG_SYMBOLIZE_KEYS: Integer
    FLAG_LAST_WINS: Integer

    def self.decode: (String input, Integer offset, Integer max_depth, Integer flags) -> [untyped, Integer]

    def self.encode: (untyped value, Integer max_depth, Proc? fallback) -> String
  end
end
