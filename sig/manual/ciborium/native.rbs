# Defined by the Rust extension under ext/ciborium, which rbs-inline cannot read.
module Ciborium
  module Native
    FLAG_SYMBOLIZE_KEYS: Integer
    FLAG_LAST_WINS: Integer
    FLAG_CTAP2: Integer

    def self.decode: (String input, Integer offset, Integer max_depth, Integer flags, Hash[Integer, ^(Integer, untyped) -> untyped]? handlers) -> [untyped, Integer]

    def self.encode: (untyped value, Integer max_depth, Integer flags, Proc? fallback, Array[[Module, ^(untyped) -> untyped]]? class_handlers) -> String

    def self.scan: (String input, Integer offset, Integer max_depth, ScanState state) -> Integer?

    # Progress of scanning one incomplete item, carried between scans.
    class ScanState
      def clear: () -> void
    end

    def self.read_head: (String input, Integer offset, Integer flags) -> [Integer, Integer?, Integer]?

    def self.encode_head: (Integer major, Integer argument) -> String
  end
end
