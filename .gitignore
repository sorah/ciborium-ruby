/.bundle/
/.yardoc
/_yardoc/
/coverage/
/doc/
/pkg/
/spec/reports/
/tmp/

# rspec failure tracking
.rspec_status

# Bundler's local config, and where CI installs gems with `bundle config path`.
/vendor/

# native extension build outputs
/ext/ciborium/target/
/lib/ciborium/*.so
/lib/ciborium/*.bundle
/lib/ciborium/[0-9]*.[0-9]*/

# Installed by `rbs collection install`; the lock file is what is checked in.
/.gem_rbs_collection/

# Resolved per downstream checkout in CI.
/spec/downstream/Gemfile.lock

# Crate license texts collected into precompiled gems by rake gem:native.
/licenses/
